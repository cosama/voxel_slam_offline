       printf("scale_gravity: %lf %lf %d\n", scale_gravity, mean_acc.norm(), init_num);
-      x_curr.g = -mean_acc * scale_gravity;
+      // voxelslam_bridge: initialization and reset share the fixed-magnitude seed.
