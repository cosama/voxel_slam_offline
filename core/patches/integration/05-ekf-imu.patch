+      for(auto &point : pcl_in.points)
+      {
+        Eigen::Matrix3d R_rel; Eigen::Vector3d p_rel;
+        voxelslam_offline::prior_deskew_point(
+            prior_frame, pcl_beg_time + point.curvature, &R_rel, &p_rel);
+
+        Eigen::Vector3d P_i(point.x, point.y, point.z);
+        Eigen::Vector3d P_compensate = Lid_rot_to_IMU.transpose() *
+            (R_rel * (Lid_rot_to_IMU * P_i + Lid_offset_to_IMU) + p_rel - Lid_offset_to_IMU);
+        point.x = P_compensate(0);
+        point.y = P_compensate(1);
+        point.z = P_compensate(2);
+      }
+      return;
+    }
