+    // voxelslam_bridge: undistort against the odometry prior when one is
+    // installed. The loop below reconstructs each point's pose by dead reckoning
+    // the IMU across the sweep, and that error is baked into the voxel map at
+    // insertion, before local BA ever sees the scan -- so no amount of later
+    // pose refinement removes it. The prior already carries the continuous
+    // motion; using it here sharpens every scan without touching the estimated
+    // trajectory at all.
+    //
+    // Both the state propagation above and `xc` are left exactly as upstream
+    // computed them. Only the per-point compensation changes, and it is the same
+    // quantity: upstream forms `xc.R^T * R_i` and `xc.R^T * (p_i - xc.p)`, the
+    // motion from the point's stamp to the sweep end in the sweep-end body
+    // frame, and that is what `prior_deskew_point` returns. Being a body-frame
+    // relative, the prior's own world frame cancels, as everywhere else in this
+    // bridge.
+    //
+    // The frame is built only when the prior spans the whole sweep, so this is
+    // all of the scan or none of it. A point the prior cannot place must not be
+    // left at its raw coordinates beside undistorted ones: that asserts it was
+    // already at the sweep-end pose, which is a full sweep of motion error baked
+    // into the voxel map, and it is worse than the IMU deskew below. The frame
+    // also copies the sweep's handful of prior samples once, so the per-point
+    // path takes no lock.
+    voxelslam_offline::PriorDeskewFrame prior_frame;
+    if(voxelslam_offline::prior_deskew_enabled() &&
+       voxelslam_offline::prior_deskew_frame(pcl_beg_time, pcl_end_time, &prior_frame))
+    {
+      for(auto &point : pcl_in.points)
+      {
+        Eigen::Matrix3d R_rel; Eigen::Vector3d p_rel;
+        voxelslam_offline::prior_deskew_point(
+            prior_frame, pcl_beg_time + point.curvature, &R_rel, &p_rel);
+
+        Eigen::Vector3d P_i(point.x, point.y, point.z);
+        Eigen::Vector3d P_compensate = Lid_rot_to_IMU.transpose() *
+            (R_rel * (Lid_rot_to_IMU * P_i + Lid_offset_to_IMU) + p_rel - Lid_offset_to_IMU);
+        point.x = P_compensate(0);
+        point.y = P_compensate(1);
+        point.z = P_compensate(2);
+      }
+      return;
+    }
