 // double imu_coef = 1e-8;
 #define DVEL 6
 // The LiDAR-Inertial BA optimizer
+inline double prior_ba_factor(vector<IMUST> &x_stats, int win_size,
+                              Eigen::MatrixXd *Hess, Eigen::VectorXd *JacT)
+{
+  double sigma_rot = 0.0, sigma_pos = 0.0;
+  if(!voxelslam_offline::prior_ba_sigma(&sigma_rot, &sigma_pos))
+    return 0.0;
+
+  const double w_rot = 1.0 / (sigma_rot * sigma_rot);
+  const double w_pos = 1.0 / (sigma_pos * sigma_pos);
+  double residual = 0.0;
+
+  // Keep the prior chain.
+  for(int i=0; i+1<win_size; i++)
+  {
+    const int j = i + 1;
+    Eigen::Matrix3d dR; Eigen::Vector3d dp;
+    // Skip uncovered poses.
+    if(!voxelslam_offline::prior_relative_motion(x_stats[i].t, x_stats[j].t, &dR, &dp))
+      continue;
+
+    IMUST &st1 = x_stats[i];
+    IMUST &st2 = x_stats[j];
+    Eigen::Matrix3d res_r = dR.transpose() * st1.R.transpose() * st2.R;
+    Eigen::Vector3d exp_t = st1.R.transpose() * (st2.p - st1.p);
+    Eigen::Vector3d res_t = exp_t - dp;
+
+    Eigen::Matrix<double, 6, 1> rr;
+    rr.head(3) = Log(res_r);
+    rr.tail(3) = res_t;
+    residual += w_rot * rr.head(3).squaredNorm() + w_pos * rr.tail(3).squaredNorm();
+
+    if(Hess == nullptr) continue;
+
+    Eigen::Matrix<double, 6, 12> joc; joc.setZero();
+    Eigen::Matrix3d JR_inv = jr_inv(res_r);
+    joc.block<3, 3>(0, 0) = -JR_inv * st2.R.transpose() * st1.R;
+    joc.block<3, 3>(0, 6) =  JR_inv;
+    joc.block<3, 3>(3, 0) =  hat(exp_t);
+    joc.block<3, 3>(3, 3) = -st1.R.transpose();
+    joc.block<3, 3>(3, 9) =  st1.R.transpose();
+
+    Eigen::Matrix<double, 6, 6> W; W.setZero();
+    W.block<3, 3>(0, 0) = w_rot * I33;
+    W.block<3, 3>(3, 3) = w_pos * I33;
+
+    Eigen::Matrix<double, 12, 12> jtj = joc.transpose() * W * joc;
+    Eigen::Matrix<double, 12, 1> gg = joc.transpose() * W * rr;
+
+    const int idx[2] = {i, j};
+    for(int a=0; a<2; a++)
+    {
+      JacT->block<6, 1>(idx[a]*DIM, 0) += gg.block<6, 1>(a*6, 0);
+      for(int b=0; b<2; b++)
+        Hess->block<6, 6>(idx[a]*DIM, idx[b]*DIM) += jtj.block<6, 6>(a*6, b*6);
+    }
+  }
+
+  return residual;
+}
