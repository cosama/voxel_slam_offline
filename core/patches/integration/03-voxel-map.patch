 // double imu_coef = 1e-8;
 #define DVEL 6
 // The LiDAR-Inertial BA optimizer
+// voxelslam_bridge: relative-pose factor from the externally supplied odometry
+// prior, for both local-BA optimizers below.
+//
+// Upstream regularizes the window with IMU preintegration alone, so a prior that
+// only warm starts the IEKF is re-decided here by the very IMU the prior was
+// brought in to replace: the window is free to rotate away from the prior, and
+// measurably does. This factor states the prior's own between-sweep motion as a
+// measurement, so the prior constrains the pose everywhere the pose is decided.
+//
+// The residual compares body-frame relative motion on both sides -- the prior's
+// (dR, dp) against the window's own -- so the arbitrary world-frame offset
+// between the prior's gravity/yaw anchor and upstream's cancels, exactly as it
+// does in `apply_prior_delta`. Only the shared IMU body frame is assumed.
+//
+// Structure and sign conventions are `IMU_PRE::give_evaluate` with dtime, v and
+// g dropped, which is what a pure relative-pose factor reduces to; the states'
+// rotation is a right perturbation and their position a world offset, matching
+// `IMUST::operator+=`, and both optimizers lay a state's rotation at offset 0
+// and its position at offset 3 within its DIM-sized block, so the same
+// scattering works for either.
+//
+// Returns twice the cost, matching `give_evaluate`'s convention, so the caller
+// applies the same 0.5 factor it applies to the IMU term.
+inline double prior_ba_factor(vector<IMUST> &x_stats, int win_size,
+                              Eigen::MatrixXd *Hess, Eigen::VectorXd *JacT)
+{
+  double sigma_rot = 0.0, sigma_pos = 0.0;
+  if(!voxelslam_offline::prior_ba_sigma(&sigma_rot, &sigma_pos))
+    return 0.0;
+
+  const double w_rot = 1.0 / (sigma_rot * sigma_rot);
+  const double w_pos = 1.0 / (sigma_pos * sigma_pos);
+  double residual = 0.0;
+
+  // Every consecutive pair, deliberately. Spanning a longer baseline instead --
+  // tying only every third pose, or only the window's endpoints -- looks like it
+  // should constrain the same accumulated motion while leaving the poses between
+  // free to be refined, and it was tried. It destroys the run: on the easiest
+  // dataset it took the ATE from 0.015 m to 4.6 m and put 2013 of 2870 sweeps
+  // into degenerate fallback, and it got worse the longer the span. The reason
+  // is the insertion ordering: each window pose's scan is already cut into the
+  // voxel map at its IEKF pose, so moving the tied poses onto the prior while
+  // leaving the untied ones where the LiDAR put them makes the window internally
+  // inconsistent with the map it was cut into, and marginalization bakes that in
+  // every slide. The chain has to be unbroken.
+  for(int i=0; i+1<win_size; i++)
+  {
+    const int j = i + 1;
+    Eigen::Matrix3d dR; Eigen::Vector3d dp;
+    // A window pose outside the prior's span simply carries no factor, which
+    // degrades to upstream's behavior for that pair rather than failing.
+    if(!voxelslam_offline::prior_relative_motion(x_stats[i].t, x_stats[j].t, &dR, &dp))
+      continue;
+
+    IMUST &st1 = x_stats[i];
+    IMUST &st2 = x_stats[j];
+    Eigen::Matrix3d res_r = dR.transpose() * st1.R.transpose() * st2.R;
+    Eigen::Vector3d exp_t = st1.R.transpose() * (st2.p - st1.p);
+    Eigen::Vector3d res_t = exp_t - dp;
+
+    Eigen::Matrix<double, 6, 1> rr;
+    rr.head(3) = Log(res_r);
+    rr.tail(3) = res_t;
+    residual += w_rot * rr.head(3).squaredNorm() + w_pos * rr.tail(3).squaredNorm();
+
+    if(Hess == nullptr) continue;
+
+    Eigen::Matrix<double, 6, 12> joc; joc.setZero();
+    Eigen::Matrix3d JR_inv = jr_inv(res_r);
+    joc.block<3, 3>(0, 0) = -JR_inv * st2.R.transpose() * st1.R;
+    joc.block<3, 3>(0, 6) =  JR_inv;
+    joc.block<3, 3>(3, 0) =  hat(exp_t);
+    joc.block<3, 3>(3, 3) = -st1.R.transpose();
+    joc.block<3, 3>(3, 9) =  st1.R.transpose();
+
+    Eigen::Matrix<double, 6, 6> W; W.setZero();
+    W.block<3, 3>(0, 0) = w_rot * I33;
+    W.block<3, 3>(3, 3) = w_pos * I33;
+
+    Eigen::Matrix<double, 12, 12> jtj = joc.transpose() * W * joc;
+    Eigen::Matrix<double, 12, 1> gg = joc.transpose() * W * rr;
+
+    const int idx[2] = {i, j};
+    for(int a=0; a<2; a++)
+    {
+      JacT->block<6, 1>(idx[a]*DIM, 0) += gg.block<6, 1>(a*6, 0);
+      for(int b=0; b<2; b++)
+        Hess->block<6, 6>(idx[a]*DIM, idx[b]*DIM) += jtj.block<6, 6>(a*6, b*6);
+    }
+  }
+
+  return residual;
+}
